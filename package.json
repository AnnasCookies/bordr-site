{
	"name": "bordr-site",
	"description": "Static landing site for bordr.dev (Cloudflare Pages).",
	"private": true,
	"version": "1.1.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/AnnasCookies/bordr-site.git"
	},
	"homepage": "https://bordr.dev",
	"engines": {
		"bun": ">=1.2"
	},
	"type": "module",
	"scripts": {
		"dev": "bun --hot scripts/serve.ts",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "bun test",
		"deploy": "env -u CLOUDFLARE_API_TOKEN -u CF_API_TOKEN wrangler deploy",
		"preview": "wrangler dev"
	},
	"devDependencies": {
		"@types/bun": "^1.2.0",
		"prettier": "^3.8.3",
		"wrangler": "^4.151.3"
	}
}
