{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bordr-site",
	"compatibility_date": "2026-09-18",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "public"
	},
	"routes": [
		{
			"pattern": "bordr.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.bordr.dev",
			"custom_domain": true
		}
	]
}
